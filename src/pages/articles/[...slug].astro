---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import PracticalGuide from '../../components/PracticalGuide.astro';
import Embed from '../../components/Embed.astro';
import { getArticleSlug } from '../../lib/articles';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('articles', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: getArticleSlug(entry) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'articles'>;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} headings={headings}>
  <Content components={{ PracticalGuide, Embed }} />
</ArticleLayout>
