{
  "name": "signal",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Signal — AI-curated news, made useful.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "ingest": "tsx scripts/ingest.ts",
    "verify": "tsx scripts/verify-article.ts",
    "test:verify": "tsx --test scripts/verify-article.test.ts",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "new-article": "tsx scripts/new-article.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "5.0.6",
    "@astrojs/rss": "4.0.18",
    "astro": "6.3.3",
    "pagefind": "1.5.2",
    "tailwindcss": "^3.4.14"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "devalue": "5.8.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
